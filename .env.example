# CafeFlow — คัดลอกเป็น .env แล้วแก้ค่า (.env ถูก gitignore ไว้ ห้าม commit)

# ── ฐานข้อมูล ──────────────────────────────────────────────
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=cafeflow
PGUSER=cafeflow
# ค่าเริ่มต้นนี้ใช้ได้แค่เครื่องพัฒนา — เครื่องร้านเปลี่ยนด้วย node ops/rotate-db-password.js
PGPASSWORD=cafeflow_dev

# ── API ───────────────────────────────────────────────────
PORT=8080
# ในร้านจริงให้ผูกเฉพาะ LAN — ห้ามเปิดพอร์ตนี้ออกอินเทอร์เน็ต (forward ที่เราเตอร์)
# :: = ทุกการ์ดเครือข่ายทั้ง IPv4 และ IPv6 (dual-stack)
# ห้ามใช้ 0.0.0.0 — Windows แปลง localhost เป็น ::1 ก่อน ถ้าฟังแค่ IPv4
# เบราว์เซอร์ต้องรอ IPv6 ล้มก่อนทุกการเชื่อมต่อ หน้าเว็บช้าลงราว 200ms ต่อเส้น
HOST=::
NODE_ENV=development

# ── ร้าน ──────────────────────────────────────────────────
# สาขาเริ่มต้นที่ seed สร้างให้ · ระบบรองรับหลายสาขาในโครงแล้วแต่ยังใช้ค่าเดียว
CF_BRANCH_CODE=MAIN
# PromptPay ID ของร้าน (เบอร์โทร / เลขประจำตัวผู้เสียภาษี / e-Wallet)
# ใช้สร้าง QR ตามยอดชำระ — ปล่อยว่างได้ในเครื่องพัฒนา
CF_PROMPTPAY_ID=

# ── บริการอ่านสลิป (เฟส 4) ────────────────────────────────
CF_OCR_URL=http://127.0.0.1:5101
# ตัวรัน (ops/run-cafeflow.ps1 อ่าน): ไม่ใส่ = OpenVINO ถ้าติดตั้ง ocr-svc\.venv-ov ไว้ (เร็วกว่า ~3 เท่า) ไม่งั้น paddle
# ใส่ CF_OCR_ENGINE=paddle เพื่อบังคับใช้ตัวเดิม
# CF_OCR_ENGINE=

# ── สำเนานอกเครื่อง (ops/offsite.sh) ──────────────────────
# โฟลเดอร์ USB/NAS ที่ mount ไว้ หรือ rclone:remote:path
# ปล่อยว่างแล้วต้องระบุปลายทางตอนเรียกสคริปต์
CF_OFFSITE=
CF_OFFSITE_KEEP=30
