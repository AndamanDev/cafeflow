{
  "name": "cafeflow-api",
  "version": "0.1.0",
  "private": true,
  "description": "CafeFlow — เซิร์ฟเวอร์ในร้าน (แหล่งความจริงของวันทำการ)",
  "//type": "ห้ามใส่ \"type\": \"module\" — shared/ ใช้ UMD ที่ต้อง require() ได้ และโปรเจกต์นี้ตั้งใจไม่มี bundler",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "reset": "node src/db/migrate.js --reset && node src/db/seed.js",
    "test": "node --test test/"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "argon2": "^0.44.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=22"
  }
}
